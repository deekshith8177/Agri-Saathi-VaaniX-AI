# ╔══════════════════════════════════════════════════╗
# ║     VaaniX Backend — Environment Variables       ║
# ╚══════════════════════════════════════════════════╝

# Server
PORT=3000

# Database file path (will be auto-created)
DB_FILE=./vaanix.db.json

# JWT (CHANGE THIS IN PRODUCTION — use a long random string)
JWT_SECRET=vaanix_change_this_secret_in_production_2026
JWT_EXPIRES=30d

# OTP expiry in minutes
OTP_EXPIRES_MIN=10

# Admin credentials
# To generate a hash: node -e "require('bcryptjs').hash('yourpassword',10).then(console.log)"
ADMIN_USER=admin
ADMIN_HASH=$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi

# CORS — comma-separated list of allowed origins (or * for all)
ALLOWED_ORIGINS=*

# ── Twilio SMS (leave empty for demo/console mode) ──
# TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx

# ── Optional: Groq AI key (also set in frontend) ──
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
